rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    match /locations/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && isImage() && isUnder5MB();
    }

    match /profiles/{userId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && isImage() && isUnder5MB();
    }
  }
}
